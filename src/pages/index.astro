---
import BaseLayout from "../layouts/BaseLayout.astro";

const socials = [
  {
    name: "Facebook",
    short: "f",
    href: "https://www.facebook.com/profile.php?id=61591334404567",
  },
  {
    name: "Instagram",
    short: "ig",
    href: "https://www.instagram.com/watervalleyvoice/",
  },
  {
    name: "YouTube",
    short: "yt",
    href: "https://www.youtube.com/channel/UCOn56MJ6u1mYxIfdJxZwvNw",
  },
];

const contactHref = "mailto:contact@watervalleyvoice.com?subject=Water%20Valley%20Voice%20Inquiry";
---

<BaseLayout
  title="Water Valley Voice | Conversations from Windsor, Colorado"
  description="Water Valley Voice shares the people, places, and conversations shaping Water Valley, Windsor, and Northern Colorado."
>
  <header class="site-header">
    <div class="nav-shell">
      <a class="brand" href="#top" aria-label="Water Valley Voice home">
        <img src="/media/images/wvv-mic-mark-web.jpg" alt="" width="48" height="48" />
        <span class="brand-text">
          <span>Water Valley</span>
          <strong>Voice</strong>
        </span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
        <span class="sr-only">Open menu</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation">
        <a href="#listen">Listen</a>
        <a href="#watch">Watch</a>
        <a href="#studio">Our studio</a>
        <a class="nav-cta" href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero">
      <picture class="hero-brand-art">
        <source media="(max-width: 640px)" srcset="/media/images/wvv-mic-mark-web.jpg" />
        <img
          src="/media/images/wvv-banner-web.jpg"
          alt="Water Valley Voice logo in black and gold on white marble"
          width="2000"
          height="916"
          fetchpriority="high"
        />
      </picture>

      <div class="hero-statement page-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> A podcast from Windsor, Colorado</p>
          <h1>Stories worth hearing.<br /><em>Voices worth knowing.</em></h1>
        </div>
        <div class="hero-aside">
          <p>
            Meaningful conversations with the neighbors, makers, business owners, and community leaders who shape the place we call home.
          </p>
          <div class="hero-actions">
            <a class="button button-gold" href="#listen">Listen to the latest</a>
            <a class="button button-line" href="#watch">Watch the podcast <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="topic-band" aria-label="Water Valley Voice topics">
      <div>
        <span>People</span><i></i><span>Places</span><i></i><span>Business</span><i></i><span>Food</span><i></i><span>Community</span><i></i><span>Home</span>
      </div>
    </section>

    <section id="listen" class="section latest-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Now playing</p>
          <h2>The latest<br /><em>conversation.</em></h2>
        </div>
        <a class="text-link" href="https://feed.podbean.com/watervalleyvoice/feed.xml" target="_blank" rel="noopener noreferrer">
          Subscribe with RSS <span aria-hidden="true">↗</span>
        </a>
      </div>

      <article class="episode-feature">
        <div class="episode-number" aria-hidden="true">
          <span>Episode</span>
          <strong>01</strong>
          <i></i>
          <small>Part 3</small>
        </div>
        <div class="episode-details">
          <p class="episode-kicker">Featured conversation</p>
          <h3>Family, Fairways &amp; Flavor</h3>
          <p class="episode-subtitle">Inside Windsor’s Grainhouse, Sandbar and Ted’s</p>
          <div class="podbean-player">
            <iframe
              title="E1 Part 3: Family, Fairways & Flavor: Inside Windsor’s Grainhouse, Sandbar and Ted’s"
              height="150"
              width="100%"
              src="https://www.podbean.com/player-v2/?i=46vsa-1b221ba-pb&from=pb6admin&pbad=0&share=1&download=1&rtl=0&fonts=Arial&skin=f6f6f6&font-color=auto&logo_link=episode_page&btn-skin=8bbb4e"
              loading="lazy"
              allowtransparency="true"
            ></iframe>
          </div>
        </div>
      </article>
    </section>

    <section id="watch" class="watch-section">
      <div class="section watch-inner">
        <div class="watch-copy">
          <p class="eyebrow eyebrow-gold"><span></span> Watch the conversations</p>
          <h2>Pull up a chair.</h2>
          <p>
            See every episode in our podcast playlist—from local founders to familiar faces and the stories behind the places you know.
          </p>
          <a class="button button-outline-light" href="https://www.youtube.com/playlist?list=PLfOdKEY1vw1g" target="_blank" rel="noopener noreferrer">
            Open on YouTube <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="video-frame">
          <iframe
            src="https://www.youtube.com/embed?listType=playlist&list=PLfOdKEY1vw1g"
            title="Water Valley Voice podcast playlist on YouTube"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section id="studio" class="studio-section">
      <div class="studio-photo">
        <img
          src="/media/images/wvv-podcast-studio-web.jpg"
          alt="The Water Valley Voice recording studio with microphones and a custom live-edge table"
          width="1800"
          height="1200"
          loading="lazy"
        />
        <span>Water Valley Voice Studio</span>
      </div>
      <div class="studio-copy">
        <p class="eyebrow eyebrow-gold"><span></span> Where we record</p>
        <h2>Built for great<br /><em>conversation.</em></h2>
        <p>
          Our Water Valley studio is where local experience, honest questions, and a little curiosity come together. Every episode begins right here in Windsor.
        </p>
        <address>
          <span>1625 Pelican Lakes Point, Suite 201</span>
          <span>Windsor, CO 80550</span>
        </address>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="contact-ornament" aria-hidden="true">V</div>
      <div class="contact-inner">
        <p class="eyebrow eyebrow-centered"><span></span> Get in touch <span></span></p>
        <h2>Have a story to share?</h2>
        <p>
          Know someone we should meet, a local place we should visit, or a conversation worth having? We’d love to hear from you.
        </p>
        <a class="contact-email" href={contactHref}>
          <span>Email Water Valley Voice</span>
          <strong>contact@watervalleyvoice.com</strong>
          <i aria-hidden="true">→</i>
        </a>
      </div>
    </section>

    <section class="social-section" aria-label="Follow Water Valley Voice">
      <div class="section social-inner">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Follow along</p>
          <h2>Stay in the conversation.</h2>
        </div>
        <div class="social-grid">
          {socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`Follow Water Valley Voice on ${social.name}`}>
              <span class="social-icon" aria-hidden="true">{social.short}</span>
              <strong>{social.name}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-main section">
      <a class="brand brand-footer" href="#top" aria-label="Water Valley Voice home">
        <img src="/media/images/wvv-mic-mark-web.jpg" alt="" width="48" height="48" loading="lazy" />
        <span class="brand-text"><span>Water Valley</span><strong>Voice</strong></span>
      </a>

      <div class="footer-contact">
        <p>Contact</p>
        <a href={contactHref}>contact@watervalleyvoice.com</a>
      </div>

      <address>
        <span>1625 Pelican Lakes Point, Suite 201</span>
        <span>Windsor, CO 80550</span>
      </address>
    </div>

    <div class="footer-bottom section">
      <p>© {new Date().getFullYear()} Water Valley Voice</p>
      <div class="parent-brand">
        <span>A podcast from</span>
        <img
          src="/media/images/201022_WV_logo_color-final_outlined_white_lettering.png"
          alt="Water Valley"
          width="220"
          height="69"
          loading="lazy"
        />
      </div>
    </div>
  </footer>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const navigation = document.querySelector<HTMLElement>(".primary-nav");
    const menuLabel = menuButton?.querySelector<HTMLElement>(".sr-only");

    const setMenu = (isOpen: boolean) => {
      menuButton?.setAttribute("aria-expanded", String(isOpen));
      navigation?.classList.toggle("is-open", isOpen);
      if (menuLabel) menuLabel.textContent = isOpen ? "Close menu" : "Open menu";
    };

    menuButton?.addEventListener("click", () => {
      setMenu(menuButton.getAttribute("aria-expanded") !== "true");
    });

    navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));

    window.addEventListener("resize", () => {
      if (window.innerWidth > 760) setMenu(false);
    });
  </script>
</BaseLayout>
