---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { studioServices } from "../data/studio-services";

const serviceOptions = studioServices;
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  (import.meta.env.DEV ? "1x00000000000000000000AA" : "");

const studioURL = new URL("/book-studio/", Astro.site).toString();
const studioSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${studioURL}#studio`,
  name: "Water Valley Voice Podcast Studio",
  url: studioURL,
  description:
    "Podcast studio and conference room rentals with DIY production gear and done-for-you recording and editing in Windsor, Colorado.",
  image: new URL("/media/images/wvv-podcast-studio-web.jpg", Astro.site).toString(),
  email: "studio@watervalleyvoice.com",
  priceRange: "$50–$1,395",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1625 Pelican Lakes Point, Suite 201",
    addressLocality: "Windsor",
    addressRegion: "CO",
    postalCode: "80550",
    addressCountry: "US",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Podcast studio and meeting room rentals",
    itemListElement: serviceOptions.map((service) => ({
      "@type": "Offer",
      price: service.price.replace(/[$,]/g, ""),
      priceCurrency: "USD",
      itemOffered: {
        "@type": "Service",
        name: `${service.eyebrow} ${service.title}`,
        description: `${service.description} ${service.duration}.`,
      },
    })),
  },
};

const bookingFaqs = [
  {
    question: "What is included in a DIY studio rental?",
    answer:
      "DIY half-day and full-day rentals include the Water Valley Voice studio space and production gear. You operate your own session during the reserved time.",
  },
  {
    question: "What is included in done-for-you production?",
    answer:
      "Done-for-you packages add recording support and editing for two episodes during a half production day or four episodes during a full production day.",
  },
  {
    question: "Is my session booked as soon as I send a request?",
    answer:
      "No. Your preferred date and time remain a request until Water Valley Voice replies by email and confirms availability.",
  },
  {
    question: "Where is the Water Valley Voice studio?",
    answer:
      "The studio is at 1625 Pelican Lakes Point, Suite 201, Windsor, Colorado 80550.",
  },
];

const bookingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: bookingFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="Podcast Studio Rental in Windsor, CO | Water Valley Voice"
  description="Book the Water Valley Voice podcast studio or conference room in Windsor, Colorado. Choose DIY space and gear or done-for-you production and editing."
  canonical={studioURL}
  socialImageAlt="Water Valley Voice podcast studio in Windsor, Colorado"
  jsonLd={[studioSchema, bookingFaqSchema]}
>
  <SiteHeader currentPage="booking" />

  <main id="main-content" class="booking-page">
    <section class="booking-hero">
      <div class="booking-hero-copy">
        <p class="eyebrow eyebrow-gold"><span></span> Studio rentals in Windsor</p>
        <h1>Podcast studio rental.<br /><em>Made for your story.</em></h1>
        <p>
          A polished, purpose-built space for podcasts, interviews, content days, and meetings—with the gear and support to match your production.
        </p>
        <a class="button button-gold" href="#booking-form">Request a session <span aria-hidden="true">↓</span></a>
      </div>
      <div class="booking-hero-photo">
        <img
          src="/media/images/wvv-podcast-studio-web.jpg"
          srcset="/media/images/wvv-podcast-studio-900.jpg 900w, /media/images/wvv-podcast-studio-web.jpg 1800w"
          sizes="(max-width: 760px) 100vw, 58vw"
          alt="Water Valley Voice podcast studio available to rent in Windsor"
          width="1800"
          height="1200"
          fetchpriority="high"
        />
        <div>
          <span>Water Valley Voice Studio</span>
          <address>1625 Pelican Lakes Point, Suite 201 · Windsor, CO 80550</address>
        </div>
      </div>
    </section>

    <section class="rental-packages section" aria-labelledby="packages-title">
      <div class="rental-heading">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Choose your setup</p>
          <h2 id="packages-title">Studio packages.</h2>
        </div>
        <p>
          Come in and run your own production, or let our team take care of the recording and editing. All sessions are scheduled by request and confirmed by email.
        </p>
      </div>

      <div class="package-grid">
        {serviceOptions.map((service, index) => (
          <article class:list={["package-card", index > 1 && index < 4 && "package-card-featured"]}>
            <div class="package-topline">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{service.eyebrow}</p>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="package-meta">
              <span>{service.duration}</span>
              <strong>{service.price}</strong>
            </div>
            <a
              href={`#service-${service.id}`}
              data-select-service={service.id}
              aria-label={`Select ${service.eyebrow} ${service.title}`}
            >
              Select this package <span aria-hidden="true">↓</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="booking-faq section" aria-labelledby="booking-faq-title">
      <div class="booking-faq-heading">
        <p class="eyebrow eyebrow-dark"><span></span> Before you request</p>
        <h2 id="booking-faq-title">Studio rental<br /><em>questions.</em></h2>
      </div>
      <div class="booking-faq-list">
        {bookingFaqs.map((faq) => (
          <details>
            <summary>{faq.question}<span aria-hidden="true">+</span></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="booking-form" class="booking-form-section">
      <div class="section booking-form-layout">
        <div class="booking-form-intro">
          <p class="eyebrow eyebrow-gold"><span></span> Request your session</p>
          <h2>Tell us what<br /><em>you need.</em></h2>
          <p>
            Choose a package and preferred date and start time. We’ll review availability and reply by email to confirm the details.
          </p>
          <div class="booking-process" aria-label="Booking process">
            <div><span>1</span><p><strong>Choose</strong>Your studio package</p></div>
            <div><span>2</span><p><strong>Request</strong>Your preferred date and time</p></div>
            <div><span>3</span><p><strong>Confirm</strong>We reply with availability</p></div>
          </div>
        </div>

        <form
          id="studio-booking-form"
          class="booking-form"
          method="post"
          action="/api/studio-request"
          accept-charset="UTF-8"
        >
          <div class="form-honeypot" aria-hidden="true">
            <label for="booking-website">Leave this field blank</label>
            <input
              id="booking-website"
              type="text"
              name="website"
              autocomplete="off"
              tabindex="-1"
            />
          </div>
          <input id="booking-started-at" type="hidden" name="startedAt" value="" />

          <fieldset class="service-fieldset">
            <legend>Select a service <span aria-hidden="true">*</span></legend>
            <div class="service-options">
              {serviceOptions.map((service) => (
                <label id={`service-${service.id}`} class="service-option">
                  <input type="radio" name="service" value={service.id} required />
                  <span class="service-check" aria-hidden="true"></span>
                  <span class="service-name">
                    <small>{service.eyebrow}</small>
                    <strong>{service.title}</strong>
                    <span>{service.duration}</span>
                  </span>
                  <b>{service.price}</b>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="details-fieldset">
            <legend>Your preferred session</legend>
            <div class="form-grid">
              <label>
                <span>Preferred date <b aria-hidden="true">*</b></span>
                <input id="booking-date" type="date" name="date" required />
              </label>
              <label>
                <span>Preferred start time <b aria-hidden="true">*</b></span>
                <input type="time" name="time" required />
              </label>
            </div>
          </fieldset>

          <fieldset class="details-fieldset">
            <legend>Your contact details</legend>
            <div class="form-grid">
              <label>
                <span>Name <b aria-hidden="true">*</b></span>
                <input type="text" name="name" autocomplete="name" maxlength="120" required />
              </label>
              <label>
                <span>Email <b aria-hidden="true">*</b></span>
                <input type="email" name="email" autocomplete="email" maxlength="254" required />
              </label>
              <label>
                <span>Phone</span>
                <input type="tel" name="phone" autocomplete="tel" maxlength="50" />
              </label>
              <label>
                <span>Company or show name</span>
                <input type="text" name="company" autocomplete="organization" maxlength="160" />
              </label>
              <label class="form-grid-full">
                <span>Tell us about your session</span>
                <textarea name="notes" rows="5" maxlength="1000" placeholder="Number of guests, episode topic, production needs, or anything else we should know."></textarea>
              </label>
            </div>
          </fieldset>

          <label class="request-confirmation">
            <input type="checkbox" name="confirmation" required />
            <span>I understand this is a request and my session is not reserved until Water Valley Voice confirms availability.</span>
          </label>

          <div class="turnstile-field">
            <p class="turnstile-label">Human verification <span aria-hidden="true">*</span></p>
            {turnstileSiteKey ? (
              <>
                <div id="studio-turnstile" class="studio-turnstile-widget"></div>
                <div class="turnstile-status-row">
                  <p id="turnstile-status" class="turnstile-status" role="status" aria-live="polite">
                    Complete the verification above when you are ready.
                  </p>
                  <button id="turnstile-retry" class="turnstile-retry" type="button" hidden>
                    Retry verification
                  </button>
                </div>
              </>
            ) : (
              <p class="turnstile-config-warning" role="alert">
                Studio requests are temporarily unavailable while secure verification is being configured.
              </p>
            )}
          </div>

          <button class="button button-gold booking-submit" type="submit" disabled={!turnstileSiteKey}>
            <span data-submit-label>Send studio request</span> <span aria-hidden="true">→</span>
          </button>
          <p class="form-help">
            Protected by Cloudflare Turnstile. Your request is sent securely to <strong>studio@watervalleyvoice.com</strong> without opening your email app.
          </p>
          <p id="booking-feedback" class="booking-feedback" role="status" aria-live="polite"></p>

          <noscript>
            <p class="booking-feedback is-visible">
              JavaScript is required for secure human verification. Please enable JavaScript to send this form, or contact studio@watervalleyvoice.com for assistance.
            </p>
          </noscript>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter />

  {
    turnstileSiteKey && (
      <script is:inline define:vars={{ turnstileSiteKey }}>
        (() => {
          const state = window.__studioTurnstile = {
            siteKey: turnstileSiteKey,
            status: "loading",
            widgetId: null,
          };

          const announce = (status, code) => {
            state.status = status;
            window.dispatchEvent(
              new CustomEvent("studio-turnstile-state", {
                detail: { status, code },
              }),
            );
          };

          window.studioTurnstileReady = () => {
            if (!window.turnstile || state.widgetId !== null) return;

            try {
              state.widgetId = window.turnstile.render("#studio-turnstile", {
                sitekey: state.siteKey,
                action: "studio_request",
                theme: "light",
                size: "flexible",
                appearance: "interaction-only",
                retry: "never",
                "refresh-expired": "manual",
                "refresh-timeout": "manual",
                "feedback-enabled": false,
                callback: () => announce("success"),
                "expired-callback": () => announce("expired"),
                "timeout-callback": () => announce("timeout"),
                "unsupported-callback": () => announce("unsupported"),
                "error-callback": (code) => {
                  announce("error", code);
                  return true;
                },
              });
            } catch {
              announce("error", "render-failed");
            }
          };

          window.studioTurnstileLoadError = () => {
            announce("error", "script-load-failed");
          };

          state.reset = () => {
            announce("loading");

            if (!window.turnstile) return;
            if (state.widgetId === null) {
              window.studioTurnstileReady();
              return;
            }

            window.turnstile.reset(state.widgetId);
          };
        })();
      </script>
    )
  }
  {
    turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=studioTurnstileReady"
        defer
        onerror="studioTurnstileLoadError()"
      ></script>
    )
  }

  <script>
    type TurnstileStatus = "loading" | "success" | "expired" | "timeout" | "unsupported" | "error";
    type StudioTurnstileWindow = Window & {
      __studioTurnstile?: {
        status: TurnstileStatus;
        reset?: () => void;
      };
    };

    const form = document.querySelector<HTMLFormElement>("#studio-booking-form");
    const dateInput = document.querySelector<HTMLInputElement>("#booking-date");
    const startedAtInput = document.querySelector<HTMLInputElement>("#booking-started-at");
    const feedback = document.querySelector<HTMLElement>("#booking-feedback");
    const submitButton = form?.querySelector<HTMLButtonElement>(".booking-submit");
    const submitLabel = submitButton?.querySelector<HTMLElement>("[data-submit-label]");
    const serviceLinks = document.querySelectorAll<HTMLAnchorElement>("[data-select-service]");
    const turnstileStatus = document.querySelector<HTMLElement>("#turnstile-status");
    const turnstileRetry = document.querySelector<HTMLButtonElement>("#turnstile-retry");

    const setDateMinimum = () => {
      if (!dateInput) return;
      const today = new Date();
      const localToday = new Date(today.getTime() - today.getTimezoneOffset() * 60_000).toISOString().slice(0, 10);
      dateInput.min = localToday;
    };

    const resetStartedAt = () => {
      if (startedAtInput) startedAtInput.value = String(Date.now());
    };

    const showFeedback = (message: string, kind: "success" | "error") => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove("is-success", "is-error");
      feedback.classList.add("is-visible", kind === "success" ? "is-success" : "is-error");
    };

    const setTurnstileStatus = (status: TurnstileStatus) => {
      if (!turnstileStatus || !turnstileRetry) return;

      turnstileStatus.classList.remove("is-success", "is-error");
      turnstileRetry.hidden = true;

      if (status === "success") {
        turnstileStatus.textContent = "Verification complete.";
        turnstileStatus.classList.add("is-success");
        return;
      }

      if (status === "loading") {
        turnstileStatus.textContent = "Complete the verification above when you are ready.";
        return;
      }

      turnstileStatus.classList.add("is-error");
      turnstileRetry.hidden = false;

      if (status === "expired") {
        turnstileStatus.textContent = "Verification expired. Please retry before sending your request.";
      } else if (status === "timeout") {
        turnstileStatus.textContent = "Verification timed out. Please retry when you are ready.";
      } else if (status === "unsupported") {
        turnstileStatus.textContent = "This browser cannot complete verification. Please try an updated browser without content-blocking extensions.";
      } else {
        turnstileStatus.textContent = "Verification could not finish. Please retry, or disable a content blocker or VPN and try again.";
      }
    };

    const resetTurnstile = () => {
      (window as StudioTurnstileWindow).__studioTurnstile?.reset?.();
    };

    window.addEventListener("studio-turnstile-state", (event) => {
      const detail = (event as CustomEvent<{ status?: TurnstileStatus }>).detail;
      if (detail?.status) setTurnstileStatus(detail.status);
    });

    const initialTurnstileStatus = (window as StudioTurnstileWindow).__studioTurnstile?.status;
    if (initialTurnstileStatus) setTurnstileStatus(initialTurnstileStatus);

    turnstileRetry?.addEventListener("click", resetTurnstile);

    setDateMinimum();
    resetStartedAt();

    serviceLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();

        const serviceId = link.dataset.selectService;
        const serviceOption = serviceId ? document.querySelector<HTMLElement>(`#service-${serviceId}`) : null;
        const radio = serviceOption?.querySelector<HTMLInputElement>('input[type="radio"]');

        if (radio) radio.checked = true;
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        serviceOption?.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "center" });
        radio?.focus({ preventScroll: true });
      });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (!data.get("cf-turnstile-response")) {
        showFeedback("Please complete the human verification before sending your request.", "error");
        return;
      }

      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = "Sending request…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        const result = (await response.json().catch(() => null)) as
          | { success?: boolean; message?: string }
          | null;

        if (!response.ok || !result?.success) {
          throw new Error(result?.message || "We could not send your request. Please try again.");
        }

        form.reset();
        setDateMinimum();
        resetStartedAt();
        resetTurnstile();
        showFeedback(
          result.message || "Your studio request was sent. We’ll reply by email after we review availability.",
          "success",
        );
      } catch (error) {
        resetTurnstile();
        showFeedback(
          error instanceof Error ? error.message : "We could not send your request. Please try again.",
          "error",
        );
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = "Send studio request";
      }
    });
  </script>
</BaseLayout>
