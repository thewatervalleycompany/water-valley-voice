---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { episodePath, episodes } from "../data/episodes";
import BaseLayout from "../layouts/BaseLayout.astro";

const formatEpisodeDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T12:00:00Z`));

const episodeArchiveSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Water Valley Voice podcast episodes",
  numberOfItems: episodes.length,
  itemListElement: episodes.map((episode, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: episode.title,
    url: new URL(`${episodePath(episode)}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title="Windsor, Colorado Podcast Episodes | Water Valley Voice"
  description="Listen to every Water Valley Voice podcast episode and meet the people, places, and ideas shaping Windsor, Water Valley, and Northern Colorado."
  socialImageAlt="Water Valley Voice podcast episode archive"
  jsonLd={episodeArchiveSchema}
>
  <SiteHeader currentPage="episodes" />

  <main id="main-content" class="episodes-page">
    <section class="episodes-hero">
      <div class="episodes-hero-copy">
        <p class="eyebrow eyebrow-gold"><span></span> The complete archive</p>
        <h1>Every story.<br /><em>Every voice.</em></h1>
        <p>
          Meet the people, places, and ideas shaping Water Valley, Windsor, and Northern Colorado—one conversation at a time.
        </p>
        <a class="button button-gold" href={`#${episodes[0].slug}`}>
          Start with episode one <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="episodes-hero-photo">
        <img
          src="/media/images/wvv-podcast-studio-web.jpg"
          srcset="/media/images/wvv-podcast-studio-900.jpg 900w, /media/images/wvv-podcast-studio-web.jpg 1800w"
          sizes="(max-width: 760px) 100vw, 60vw"
          alt="The Water Valley Voice podcast studio"
          width="1800"
          height="1200"
          fetchpriority="high"
        />
        <div class="episodes-hero-count">
          <strong>{String(episodes.length).padStart(2, "0")}</strong>
          <span>Conversations<br />and counting</span>
        </div>
      </div>
    </section>

    <section class="episode-archive section" aria-labelledby="episode-archive-title">
      <header class="archive-heading">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Listen from the beginning</p>
          <h2 id="episode-archive-title">The episodes.</h2>
        </div>
      </header>

      <div class="archive-list">
        {episodes.map((episode, index) => (
          <article
            id={episode.slug}
            class="archive-episode"
            aria-labelledby={`episode-title-${episode.slug}`}
          >
            <div class="archive-episode-mark" aria-hidden="true">
              <span>{episode.label}</span>
              <strong>{episode.number}</strong>
              <i></i>
              <img src="/media/images/wvv-mic-mark-480.jpg" alt="" width="480" height="480" loading="lazy" />
            </div>

            <div class="archive-episode-content">
              <div class="archive-episode-meta">
                <p>{episode.kicker}</p>
                {index === episodes.length - 1 && <span>Latest</span>}
              </div>
              <h3 id={`episode-title-${episode.slug}`}>
                <a href={episodePath(episode)}>
                  <span class="sr-only">{episode.label}: </span>{episode.title}
                </a>
              </h3>
              <p class="archive-episode-lead">{episode.teaser}</p>
              <p class="archive-episode-facts">
                <time datetime={episode.publishedDate}>{formatEpisodeDate(episode.publishedDate)}</time>
                <span aria-hidden="true">•</span>
                <span>{episode.durationLabel}</span>
              </p>

              <div class="podbean-player archive-player">
                <iframe
                  title={episode.playerTitle}
                  height="150"
                  width="100%"
                  src={episode.playerSrc}
                  loading="lazy"
                  allowtransparency="true"
                  data-name="pb-iframe-player"
                ></iframe>
              </div>

              <a class="episode-description-link" href={episodePath(episode)}>
                <span>Read full episode description</span>
                <i aria-hidden="true">→</i>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="episode-subscribe">
      <div class="section episode-subscribe-inner">
        <div>
          <p class="eyebrow eyebrow-gold"><span></span> Never miss a conversation</p>
          <h2>Follow the story<br /><em>wherever you listen.</em></h2>
        </div>
        <div class="episode-subscribe-actions">
          <a class="button button-gold" href="https://feed.podbean.com/watervalleyvoice/feed.xml" target="_blank" rel="noopener noreferrer">
            Subscribe with RSS <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-outline-light" href="https://www.youtube.com/playlist?list=PLfOdKEY1vw1g" target="_blank" rel="noopener noreferrer">
            Watch on YouTube <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
