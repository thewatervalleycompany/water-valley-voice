---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { episodePath, episodes, latestEpisode } from "../data/episodes";
import BaseLayout from "../layouts/BaseLayout.astro";

const formatEpisodeDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T12:00:00Z`));

const durationToSeconds = (duration: string) => {
  const match = duration.match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/);
  if (!match) return 0;

  return Number(match[1] ?? 0) * 3600 + Number(match[2] ?? 0) * 60 + Number(match[3] ?? 0);
};

const episodeArchiveSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": new URL("/episodes/#episode-list", Astro.site).toString(),
  name: "Water Valley Voice podcast episodes",
  numberOfItems: episodes.length,
  itemListElement: episodes.map((episode, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: episode.title,
    url: new URL(episodePath(episode), Astro.site).toString(),
  })),
};
---

<BaseLayout
  title="Windsor, Colorado Podcast Episodes | Water Valley Voice"
  description="Listen to every Water Valley Voice podcast episode and meet the people, places, and ideas shaping Windsor, Water Valley, and Northern Colorado."
  socialImageAlt="Water Valley Voice podcast episode archive"
  pageType="CollectionPage"
  mainEntityId={episodeArchiveSchema["@id"]}
  jsonLd={episodeArchiveSchema}
>
  <SiteHeader currentPage="episodes" />

  <main id="main-content" class="episodes-page">
    <section class="episodes-hero">
      <div class="episodes-hero-copy">
        <p class="eyebrow eyebrow-gold"><span></span> The complete archive</p>
        <h1>Hear from<br /><em>the source.</em></h1>
        <p>
          Experience the heart of The Water Valley Company and their love for Northern Colorado.
        </p>
        <a class="button button-gold" href={`#${episodes[0].slug}`}>
          Start with episode one <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="episodes-hero-photo">
        <img
          src="/media/images/wvv-podcast-studio-web.jpg"
          srcset="/media/images/wvv-podcast-studio-900.jpg 900w, /media/images/wvv-podcast-studio-web.jpg 1800w"
          sizes="(max-width: 760px) 100vw, 60vw"
          alt="The Water Valley Voice podcast studio"
          width="1800"
          height="1200"
          fetchpriority="high"
        />
        <div class="episodes-hero-count">
          <strong>{String(episodes.length).padStart(2, "0")}</strong>
          <span>Conversations<br />and counting</span>
        </div>
      </div>
    </section>

    <section class="episode-archive section" aria-labelledby="episode-archive-title">
      <header class="archive-heading">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Listen from the beginning</p>
          <h2 id="episode-archive-title">The episodes.</h2>
        </div>

        <details class="episode-jump" id="episode-jump">
          <summary>
            <span>Jump to an episode</span>
            <i aria-hidden="true"></i>
          </summary>
          <nav class="episode-jump-menu" aria-label="Jump to an episode">
            <ul>
              {episodes.map((episode) => (
                <li>
                  <a class="episode-jump-scroll" href={`#${episode.slug}`}>
                    <span>{episode.label}</span>
                    <strong>{episode.title}</strong>
                  </a>
                  <a
                    class="episode-jump-page"
                    href={episodePath(episode)}
                    aria-label={`Open ${episode.label}: ${episode.title}`}
                  >
                    View page <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </header>

      <div class="archive-tools" aria-label="Find and order episodes">
        <div class="archive-search">
          <label for="episode-search">Search episodes</label>
          <div class="archive-search-field">
            <span aria-hidden="true"></span>
            <input
              id="episode-search"
              type="search"
              inputmode="search"
              autocomplete="off"
              placeholder="Search people, places, or topics"
              aria-describedby="episode-search-help episode-results-status"
            />
            <button class="archive-search-clear" type="button" hidden>Clear</button>
          </div>
          <p id="episode-search-help">Type what you remember about the episode.</p>
        </div>

        <label class="archive-order" for="episode-order">
          <span>Order by</span>
          <span class="archive-order-field">
            <select id="episode-order">
              <option value="newest">Newest to oldest</option>
              <option value="oldest" selected>Oldest to newest</option>
              <option value="longest">Longest to shortest</option>
              <option value="shortest">Shortest to longest</option>
            </select>
            <i aria-hidden="true"></i>
          </span>
        </label>

        <p id="episode-results-status" class="archive-results-status" role="status" aria-live="polite">
          Showing all {episodes.length} episodes
        </p>
      </div>

      <div class="archive-list" id="episode-list">
        {episodes.map((episode, index) => (
          <article
            id={episode.slug}
            class="archive-episode"
            aria-labelledby={`episode-title-${episode.slug}`}
            data-original-index={index}
            data-published-date={episode.publishedDate}
            data-duration-seconds={durationToSeconds(episode.duration)}
            data-search-title={`${episode.label} ${episode.title}`}
            data-search-topics={episode.topics.join(" ")}
            data-search-body={`${episode.kicker} ${episode.teaser} ${episode.guests.join(" ")}`}
          >
            <div class="archive-episode-mark" aria-hidden="true">
              <span>{episode.label}</span>
              <strong>{episode.number}</strong>
              <i></i>
              <img src="/media/images/wvv-mic-mark-480.jpg" alt="" width="480" height="480" loading="lazy" />
            </div>

            <div class="archive-episode-content">
              <div class="archive-episode-meta">
                <p>{episode.kicker}</p>
                {episode.slug === latestEpisode.slug && <span>Latest</span>}
              </div>
              <h3 id={`episode-title-${episode.slug}`}>
                <a href={episodePath(episode)}>
                  <span class="sr-only">{episode.label}: </span>{episode.title}
                </a>
              </h3>
              <p class="archive-episode-lead">{episode.teaser}</p>
              <p class="archive-episode-facts">
                <time datetime={episode.publishedDate}>{formatEpisodeDate(episode.publishedDate)}</time>
                <span aria-hidden="true">•</span>
                <span>{episode.durationLabel}</span>
              </p>

              <div class="podbean-player archive-player">
                <iframe
                  title={episode.playerTitle}
                  height="150"
                  width="100%"
                  src={episode.playerSrc}
                  loading="lazy"
                  allowtransparency="true"
                  data-name="pb-iframe-player"
                ></iframe>
              </div>

              <a class="episode-description-link" href={episodePath(episode)}>
                <span>Read full episode description</span>
                <i aria-hidden="true">→</i>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="archive-empty" id="episode-empty" hidden>
        <p class="eyebrow eyebrow-dark"><span></span> No close matches yet</p>
        <h3>Try another way of saying it.</h3>
        <p>Search for a guest, place, business, or topic—or clear your search to see every episode.</p>
        <button class="button button-gold" type="button">Clear search</button>
      </div>
    </section>

    <section class="episode-subscribe">
      <div class="section episode-subscribe-inner">
        <div>
          <p class="eyebrow eyebrow-gold"><span></span> Never miss a conversation</p>
          <h2>Follow the story<br /><em>wherever you listen.</em></h2>
        </div>
        <div class="episode-subscribe-actions">
          <a class="button button-gold" href="https://feed.podbean.com/watervalleyvoice/feed.xml" target="_blank" rel="noopener noreferrer">
            Subscribe with RSS <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-outline-light" href="https://www.youtube.com/playlist?list=PLfOdKEY1vw1g" target="_blank" rel="noopener noreferrer">
            Watch on YouTube <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const archiveList = document.querySelector<HTMLElement>("#episode-list");
  const searchInput = document.querySelector<HTMLInputElement>("#episode-search");
  const clearButton = document.querySelector<HTMLButtonElement>(".archive-search-clear");
  const emptyState = document.querySelector<HTMLElement>("#episode-empty");
  const emptyClearButton = emptyState?.querySelector<HTMLButtonElement>("button");
  const orderSelect = document.querySelector<HTMLSelectElement>("#episode-order");
  const resultsStatus = document.querySelector<HTMLElement>("#episode-results-status");
  const jumpMenu = document.querySelector<HTMLDetailsElement>("#episode-jump");

  const cards = archiveList
    ? Array.from(archiveList.querySelectorAll<HTMLElement>(".archive-episode"))
    : [];

  const stopWords = new Set([
    "a", "about", "an", "and", "are", "at", "be", "for", "from", "how", "i", "in", "is", "it", "of",
    "on", "or", "that", "the", "their", "this", "to", "was", "what", "when", "where", "who", "with",
  ]);

  const conceptGroups = [
    ["history", "origin", "founded", "founder", "beginning", "began", "legacy", "past"],
    ["restaurant", "restaurants", "food", "dining", "eat", "meal", "menu", "hospitality"],
    ["hockey", "sports", "arena", "eagles", "ice", "player", "players"],
    ["golf", "course", "fairway", "fairways"],
    ["development", "developer", "developing", "build", "building", "land", "planning", "project", "projects", "real", "estate"],
    ["water", "lake", "lakes", "pond", "ponds", "flood", "marina"],
    ["family", "community", "people", "neighbor", "neighbors", "leadership"],
    ["business", "businesses", "company", "career", "careers", "job", "jobs", "work"],
    ["event", "events", "entertainment", "concert", "concerts", "plaza"],
    ["controversy", "politics", "lawsuit", "petition", "public", "financing"],
  ];

  const normalize = (value: string) =>
    value
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();

  const similarity = (left: string, right: string) => {
    if (left === right) return 1;
    if (!left.length || !right.length) return 0;

    const previous = Array.from({ length: right.length + 1 }, (_, index) => index);
    for (let leftIndex = 1; leftIndex <= left.length; leftIndex += 1) {
      let diagonal = previous[0];
      previous[0] = leftIndex;

      for (let rightIndex = 1; rightIndex <= right.length; rightIndex += 1) {
        const above = previous[rightIndex];
        const cost = left[leftIndex - 1] === right[rightIndex - 1] ? 0 : 1;
        previous[rightIndex] = Math.min(previous[rightIndex] + 1, previous[rightIndex - 1] + 1, diagonal + cost);
        diagonal = above;
      }
    }

    return 1 - previous[right.length] / Math.max(left.length, right.length);
  };

  const scoreCard = (card: HTMLElement, rawQuery: string) => {
    const query = normalize(rawQuery);
    if (!query) return 1;

    const title = normalize(card.dataset.searchTitle ?? "");
    const topics = normalize(card.dataset.searchTopics ?? "");
    const body = normalize(card.dataset.searchBody ?? "");
    const allText = `${title} ${topics} ${body}`;
    const episodeWords = Array.from(new Set(allText.split(" ").filter(Boolean)));
    const queryWords = query.split(" ").filter((word) => word.length > 1 && !stopWords.has(word));
    const usefulWords = queryWords.length ? queryWords : query.split(" ").filter(Boolean);
    let score = 0;

    if (title.includes(query)) score += 36;
    else if (topics.includes(query)) score += 26;
    else if (body.includes(query)) score += 16;

    usefulWords.forEach((word) => {
      if (title.split(" ").includes(word)) score += 14;
      else if (title.includes(word)) score += 10;

      if (topics.split(" ").includes(word)) score += 12;
      else if (topics.includes(word)) score += 8;

      if (body.includes(word)) score += 5;

      conceptGroups.forEach((group) => {
        if (!group.includes(word)) return;
        const relatedMatches = group.filter((relatedWord) => allText.includes(relatedWord)).length;
        score += Math.min(relatedMatches * 2, 8);
      });

      if (word.length >= 4 && !allText.includes(word)) {
        const bestFuzzyMatch = episodeWords.reduce(
          (best, episodeWord) => Math.max(best, similarity(word, episodeWord)),
          0,
        );
        if (bestFuzzyMatch >= 0.8) score += 5;
        else if (bestFuzzyMatch >= 0.7) score += 2;
      }
    });

    return score;
  };

  const compareCards = (left: HTMLElement, right: HTMLElement) => {
    const order = orderSelect?.value ?? "oldest";
    const leftDate = Date.parse(left.dataset.publishedDate ?? "") || 0;
    const rightDate = Date.parse(right.dataset.publishedDate ?? "") || 0;
    const leftDuration = Number(left.dataset.durationSeconds ?? 0);
    const rightDuration = Number(right.dataset.durationSeconds ?? 0);
    const leftIndex = Number(left.dataset.originalIndex ?? 0);
    const rightIndex = Number(right.dataset.originalIndex ?? 0);

    if (order === "newest") return rightDate - leftDate || rightIndex - leftIndex;
    if (order === "longest") return rightDuration - leftDuration || leftIndex - rightIndex;
    if (order === "shortest") return leftDuration - rightDuration || leftIndex - rightIndex;
    return leftDate - rightDate || leftIndex - rightIndex;
  };

  const updateArchive = () => {
    if (!archiveList || !searchInput || !resultsStatus || !emptyState || !clearButton) return;

    const query = searchInput.value.trim();
    const scoredCards = cards.map((card) => ({ card, score: scoreCard(card, query) }));
    const maximumScore = Math.max(0, ...scoredCards.map(({ score }) => score));
    const minimumScore = query ? Math.max(2, Math.floor(maximumScore * 0.28)) : 0;
    const matchingCards = scoredCards
      .filter(({ score }) => !query || (score > 0 && score >= minimumScore))
      .map(({ card }) => card);

    cards.forEach((card) => {
      card.hidden = !matchingCards.includes(card);
    });

    const orderedCards = cards.slice().sort(compareCards);
    const currentOrder = Array.from(archiveList.querySelectorAll<HTMLElement>(":scope > .archive-episode"));
    const orderChanged = orderedCards.some((card, index) => currentOrder[index] !== card);
    if (orderChanged) archiveList.append(...orderedCards);

    const count = matchingCards.length;
    const episodeWord = count === 1 ? "episode" : "episodes";
    resultsStatus.textContent = query
      ? `${count} ${episodeWord} found for “${query}”`
      : `Showing all ${cards.length} episodes`;
    emptyState.hidden = count !== 0;
    clearButton.hidden = !query;
  };

  const clearSearch = () => {
    if (!searchInput) return;
    searchInput.value = "";
    updateArchive();
    searchInput.focus();
  };

  searchInput?.addEventListener("input", updateArchive);
  searchInput?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && searchInput.value) {
      event.preventDefault();
      clearSearch();
    }
  });
  clearButton?.addEventListener("click", clearSearch);
  emptyClearButton?.addEventListener("click", clearSearch);
  orderSelect?.addEventListener("change", updateArchive);

  jumpMenu?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    jumpMenu.open = false;
    jumpMenu.querySelector<HTMLElement>("summary")?.focus();
  });
  jumpMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      jumpMenu.open = false;
    });
  });
  document.addEventListener("click", (event) => {
    if (jumpMenu?.open && event.target instanceof Node && !jumpMenu.contains(event.target)) {
      jumpMenu.open = false;
    }
  });

  updateArchive();
</script>
