---
import type { GetStaticPaths } from "astro";
import EpisodeAd from "../../components/EpisodeAd.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getEpisodeAds } from "../../data/episode-ads";
import { episodePath, episodes, type Episode } from "../../data/episodes";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  episode: Episode;
  previousEpisode?: Episode;
  nextEpisode?: Episode;
}

export const getStaticPaths = (() =>
  episodes.map((episode, index) => ({
    params: { slug: episode.slug },
    props: {
      episode,
      previousEpisode: episodes[index - 1],
      nextEpisode: episodes[index + 1],
    },
  }))) satisfies GetStaticPaths;

const { episode, previousEpisode, nextEpisode } = Astro.props;
const episodeAds = getEpisodeAds(episode.slug);
const canonicalURL = new URL(episodePath(episode), Astro.site).toString();
const facebookShareURL = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalURL)}`;
const youtubeEmbedUrl = episode.youtubeVideoId
  ? `https://www.youtube-nocookie.com/embed/${episode.youtubeVideoId}?rel=0`
  : undefined;
const episodeSchemaId = `${canonicalURL}#podcast-episode`;
const webpageSchemaId = `${canonicalURL}#webpage`;
const breadcrumbSchemaId = `${canonicalURL}#breadcrumb`;
const podcastSchemaId = new URL("/#podcast", Astro.site).toString();
const hostSchemaId = new URL("/about/#marissa-donahoo", Astro.site).toString();
const organizationSchemaId = new URL("/#organization", Astro.site).toString();
const episodeImageURL = episode.youtubeVideoId
  ? `https://i.ytimg.com/vi/${episode.youtubeVideoId}/maxresdefault.jpg`
  : new URL("/og.png", Astro.site).toString();
const videoSchema =
  episode.youtubeVideoId && episode.youtubeUrl && episode.youtubeUploadDate && youtubeEmbedUrl
    ? {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        "@id": `${canonicalURL}#video`,
        name: episode.playerTitle,
        description: episode.metaDescription,
        url: episode.youtubeUrl,
        embedUrl: youtubeEmbedUrl,
        thumbnailUrl: episodeImageURL,
        uploadDate: episode.youtubeUploadDate,
        duration: episode.duration,
        inLanguage: "en-US",
        publisher: { "@id": organizationSchemaId },
        isPartOf: {
          "@id": episodeSchemaId,
        },
      }
    : undefined;
const publishedDateLabel = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${episode.publishedDate}T12:00:00Z`));
const episodeSchema = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "@id": episodeSchemaId,
  name: episode.title,
  description: episode.metaDescription,
  url: canonicalURL,
  mainEntityOfPage: { "@id": webpageSchemaId },
  episodeNumber: episode.part
    ? `${Number.parseInt(episode.number, 10)} ${episode.part}`
    : Number.parseInt(episode.number, 10),
  datePublished: episode.publishedDateTime,
  timeRequired: episode.duration,
  image: { "@id": `${canonicalURL}#primaryimage` },
  inLanguage: "en-US",
  keywords: episode.topics,
  about: episode.topics.map((name) => ({ "@type": "Thing", name })),
  author: { "@id": hostSchemaId },
  publisher: { "@id": organizationSchemaId },
  contributor: episode.guests.map((name) => ({
    "@type": "Person",
    name,
  })),
  partOfSeries: {
    "@id": podcastSchemaId,
  },
  associatedMedia: [
    {
      "@type": "AudioObject",
      "@id": `${canonicalURL}#audio`,
      name: episode.playerTitle,
      embedUrl: episode.playerSrc,
      contentUrl: episode.audioUrl,
      duration: episode.duration,
      encodingFormat: "audio/mpeg",
    },
    ...(videoSchema
      ? [
          {
            "@type": "VideoObject",
            "@id": videoSchema["@id"],
          },
        ]
      : []),
  ],
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": breadcrumbSchemaId,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Episodes",
      item: new URL("/episodes/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: episode.title,
      item: canonicalURL,
    },
  ],
};
---

<BaseLayout
  title={episode.seoTitle}
  description={episode.metaDescription}
  canonical={canonicalURL}
  socialImage={episodeImageURL}
  socialImageAlt={episode.socialImageAlt}
  socialImageWidth={episode.youtubeVideoId ? 1280 : 1200}
  socialImageHeight={episode.youtubeVideoId ? 720 : 630}
  socialImageType={episode.youtubeVideoId ? "image/jpeg" : "image/png"}
  ogType="article"
  publishedTime={episode.publishedDateTime}
  mainEntityId={episodeSchemaId}
  breadcrumbId={breadcrumbSchemaId}
  jsonLd={[episodeSchema, ...(videoSchema ? [videoSchema] : []), breadcrumbSchema]}
>
  <SiteHeader currentPage="episodes" />

  <main id="main-content" class="episode-detail-page">
    <section class="episode-detail-hero">
      <div class="section episode-detail-hero-inner">
        <div class="episode-detail-heading">
          <a class="episode-back-link" href="/episodes/"><span aria-hidden="true">←</span> All episodes</a>
          <p class="eyebrow eyebrow-gold"><span></span> {episode.label}</p>
          <h1>{episode.title}</h1>
          <p class="episode-detail-teaser">{episode.teaser}</p>
          <dl class="episode-hero-facts" aria-label="Episode details">
            <div>
              <dt>Published</dt>
              <dd><time datetime={episode.publishedDate}>{publishedDateLabel}</time></dd>
            </div>
            <div>
              <dt>Run time</dt>
              <dd>{episode.durationLabel}</dd>
            </div>
            <div>
              <dt>Host</dt>
              <dd>Marissa Donahoo</dd>
            </div>
            <div class="episode-hero-fact--featuring">
              <dt>Featuring</dt>
              <dd>{episode.guests.join(", ")}</dd>
            </div>
          </dl>
        </div>

        <div class="episode-detail-mark" aria-hidden="true">
          <span>Water Valley Voice</span>
          <strong>{episode.number}</strong>
          <i></i>
          <small>{episode.part ?? episode.kicker}</small>
          <img src="/media/images/wvv-mic-mark-480.jpg" alt="" width="480" height="480" />
        </div>
      </div>
    </section>

    <section class="section episode-detail-content">
      <div class="episode-detail-main">
        <EpisodeAd ad={episodeAds.mobileTop} placement="mobileTop" />

        <div class="episode-media-stack">
          {youtubeEmbedUrl && episode.youtubeUrl && (
            <section class="episode-media" aria-labelledby="episode-watch-title">
              <div class="episode-media-heading">
                <div>
                  <p class="eyebrow eyebrow-dark"><span></span> Watch</p>
                  <h2 id="episode-watch-title">Watch the conversation.</h2>
                </div>
                <a class="episode-media-link" href={episode.youtubeUrl} target="_blank" rel="noopener noreferrer">
                  Open on YouTube <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="video-frame episode-video-frame">
                <iframe
                  src={youtubeEmbedUrl}
                  title={`Watch ${episode.playerTitle} on YouTube`}
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
            </section>
          )}

          <section class="episode-media episode-audio" aria-labelledby="episode-listen-title">
            <div class="episode-media-heading">
              <div>
                <p class="eyebrow eyebrow-dark"><span></span> Listen</p>
                <h2 id="episode-listen-title">
                  {youtubeEmbedUrl ? "Prefer to listen?" : "Listen to the conversation."}
                </h2>
              </div>
              <a class="episode-media-link" href={episode.podbeanUrl} target="_blank" rel="noopener noreferrer">
                Open on Podbean <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="podbean-player episode-detail-player">
              <iframe
                title={episode.playerTitle}
                height="150"
                width="100%"
                src={episode.playerSrc}
                loading="lazy"
                allowtransparency="true"
                data-name="pb-iframe-player"
              ></iframe>
            </div>
          </section>
        </div>

        <article class="episode-story" aria-labelledby="episode-story-title">
          <p class="eyebrow eyebrow-dark"><span></span> Full episode description</p>
          <h2 id="episode-story-title">The story behind<br /><em>the conversation.</em></h2>
          <div class="episode-story-copy">
            {episode.description.map((paragraph, index) =>
              index === 0 && episode.slug === "episode-1-part-2" ? (
                <p>
                  In this episode of <strong>Water Valley Voice</strong>, host Marissa Donahoo sits down with several of the people whose stories and careers have helped shape the Water Valley Company and the Northern Colorado community.
                </p>
              ) : (
                <p>{paragraph}</p>
              )
            )}
          </div>
        </article>

        <EpisodeAd ad={episodeAds.lowerBanner} placement="lowerBanner" />

        <section
          class="episode-share"
          aria-labelledby="episode-share-title"
          data-episode-share
          data-share-title={episode.playerTitle}
          data-share-text={episode.teaser}
          data-share-url={canonicalURL}
        >
          <div class="episode-share-copy">
            <p class="eyebrow eyebrow-gold"><span></span> Pass it along</p>
            <h2 id="episode-share-title">Share this episode.</h2>
            <p>Know someone who would enjoy this conversation? Send it their way.</p>
          </div>
          <div class="episode-share-actions">
            <button class="episode-share-action episode-share-primary" type="button" data-native-share hidden>
              Share episode <span aria-hidden="true">↗</span>
            </button>
            <a
              class="episode-share-action"
              href={facebookShareURL}
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook <span aria-hidden="true">↗</span>
            </a>
            <button class="episode-share-action" type="button" data-copy-share>
              Copy link <span aria-hidden="true">⧉</span>
            </button>
          </div>
          <p class="episode-share-status" role="status" aria-live="polite" data-share-status></p>
        </section>
      </div>

      <div class:list={["episode-detail-rail", { "episode-detail-rail--with-ad": Boolean(episodeAds.desktopTower) }]}>
        <aside class="episode-detail-aside" aria-label="Episode links">
          <div>
            <p class="episode-aside-label">Keep listening</p>
            <a href={episode.podbeanUrl} target="_blank" rel="noopener noreferrer">
              Open on Podbean <span aria-hidden="true">↗</span>
            </a>
            <a href="https://feed.podbean.com/watervalleyvoice/feed.xml" target="_blank" rel="noopener noreferrer">
              Subscribe with RSS <span aria-hidden="true">↗</span>
            </a>
            <a
              href={episode.youtubeUrl ?? "https://www.youtube.com/playlist?list=PLfOdKEY1vw1g"}
              target="_blank"
              rel="noopener noreferrer"
            >
              {episode.youtubeUrl ? "Watch this episode on YouTube" : "Watch on YouTube"} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </aside>

        <EpisodeAd ad={episodeAds.desktopTower} placement="desktopTower" />
      </div>
    </section>

    <nav class="section episode-pagination" aria-label="Episode navigation">
      {previousEpisode ? (
        <a class="episode-pagination-link episode-pagination-previous" href={episodePath(previousEpisode)}>
          <span><i aria-hidden="true">←</i> Previous episode</span>
          <strong>{previousEpisode.title}</strong>
        </a>
      ) : (
        <a class="episode-pagination-link episode-pagination-previous" href="/episodes/">
          <span><i aria-hidden="true">←</i> Episode archive</span>
          <strong>Explore every conversation</strong>
        </a>
      )}

      {nextEpisode ? (
        <a class="episode-pagination-link episode-pagination-next" href={episodePath(nextEpisode)}>
          <span>Next episode <i aria-hidden="true">→</i></span>
          <strong>{nextEpisode.title}</strong>
        </a>
      ) : (
        <a class="episode-pagination-link episode-pagination-next" href="/episodes/">
          <span>Episode archive <i aria-hidden="true">→</i></span>
          <strong>Explore every conversation</strong>
        </a>
      )}
    </nav>
  </main>

  <SiteFooter />

  <script>
    const sharePanel = document.querySelector<HTMLElement>("[data-episode-share]");

    if (sharePanel) {
      const nativeShareButton = sharePanel.querySelector<HTMLButtonElement>("[data-native-share]");
      const copyShareButton = sharePanel.querySelector<HTMLButtonElement>("[data-copy-share]");
      const shareStatus = sharePanel.querySelector<HTMLElement>("[data-share-status]");
      const title = sharePanel.dataset.shareTitle ?? document.title;
      const text = sharePanel.dataset.shareText ?? "Listen to this episode of Water Valley Voice.";
      const url = sharePanel.dataset.shareUrl ?? window.location.href;
      const shareData = { title, text, url };

      const setStatus = (message: string) => {
        if (shareStatus) shareStatus.textContent = message;
      };

      const copyLink = async () => {
        setStatus("");
        try {
          if (!navigator.clipboard || !window.isSecureContext) throw new Error("Clipboard unavailable.");
          await navigator.clipboard.writeText(url);

          setStatus("Episode link copied.");
        } catch {
          setStatus("The link could not be copied automatically. Copy it from your browser’s address bar.");
        }
      };

      const canUseNativeShare =
        typeof navigator.share === "function" &&
        (typeof navigator.canShare !== "function" || navigator.canShare(shareData));

      if (nativeShareButton && canUseNativeShare) {
        nativeShareButton.hidden = false;
        nativeShareButton.addEventListener("click", async () => {
          setStatus("");
          try {
            await navigator.share(shareData);
            setStatus("Episode shared.");
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") return;
            setStatus("Sharing did not open. You can copy the link instead.");
          }
        });
      }

      copyShareButton?.addEventListener("click", copyLink);
    }
  </script>
</BaseLayout>
