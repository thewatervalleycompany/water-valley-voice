---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Water Valley Voice | Local stories from Windsor, Colorado",
  description = "Water Valley Voice shares the people, places, and stories that make Windsor and Northern Colorado feel like home.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/media/images/wvv-mic-mark-web.jpg" />
    <link rel="apple-touch-icon" href="/media/images/wvv-mic-mark-web.jpg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Water Valley Voice Podcast" href="https://feed.podbean.com/watervalleyvoice/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#090909" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
