# dependencies
node_modules/

# build output
dist/
.astro/

# local environment files
.env
.env.*
!.env.example

# operating system files
.DS_Store

# Cloudflare local state
.wrangler/

# Original episode-ad uploads stay local; only optimized public copies ship.
/episode-ad-sources/300x600/*
!/episode-ad-sources/300x600/.gitkeep
/episode-ad-sources/728x90/*
!/episode-ad-sources/728x90/.gitkeep
/episode-ad-sources/970x250/*
!/episode-ad-sources/970x250/.gitkeep

# Exclusive media stays local until it is optimized and uploaded separately.
/exclusive-sources/*
!/exclusive-sources/README.md
