{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "water-valley-voice-studio-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["website@watervalleyvoice.com"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
